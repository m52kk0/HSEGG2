# Порт единственного процесса (Hono отдаёт и API, и собранный фронт)
PORT=8080
# Путь к файлу SQLite. В контейнере смонтируй volume на /data
DATABASE_PATH=/data/cursus.db
# Токен для /admin и GET /api/admin/stats. Пусто => демо-режим без защиты
ADMIN_TOKEN=
# ID Яндекс Метрики. Пусто => скрипт метрики не подключается (в MVP пусто)
VITE_YM_ID=
# Фоновое обновление списка вузов из Wikidata (по умолчанию выключено)
REFRESH_WIKIDATA=false
# Таймаут запроса к API «Работа России», мс
VACANCIES_TIMEOUT_MS=4000
# Время жизни кэша вакансий, часов
VACANCIES_CACHE_TTL_H=6
