{
  "name": "cursus",
  "version": "1.0.0",
  "private": true,
  "description": "Cursus — навигатор поступления. Не гадай — проложи курс.",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"pnpm -F @cursus/web dev\" \"pnpm -F @cursus/api dev\"",
    "build": "pnpm -F @cursus/web build && pnpm -F @cursus/api build",
    "start": "node apps/api/dist/index.js",
    "lint": "eslint . --max-warnings=0 && stylelint \"apps/web/src/**/*.css\"",
    "typecheck": "tsc -p packages/core && tsc -p packages/data && tsc -p apps/api && tsc -p apps/web && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "gen:programs": "tsx scripts/generate-demo-programs.ts",
    "format": "prettier --write .",
    "docker:smoke": "node scripts/docker-smoke.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@cursus/core": "workspace:*",
    "@cursus/data": "workspace:*",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "zod": "^3.24.1"
  },
  "type": "module"
}